{
  "expo": {
    "name": "PlayOS",
    "slug": "playos",
    "owner": "playos-sa",
    "scheme": "playos",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFF8F0"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "sa.playos.app",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "UIBackgroundModes": ["remote-notification"],
        "NSUserTrackingUsageDescription": "PlayOS does not track you across other apps or websites."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFF8F0"
      },
      "package": "sa.playos.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.WAKE_LOCK",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF9F0A",
          "defaultChannel": "match-reminders"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8F0",
          "image": "./assets/splash.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/01bef037-9117-4d85-b96c-7af2e9e2ee61"
    },
    "extra": {
      "eas": {
        "projectId": "01bef037-9117-4d85-b96c-7af2e9e2ee61"
      },
      "supabaseUrl": "https://tnqlvszrcskvuqtdcded.supabase.co",
      "supabaseAnonKey": "sb_publishable_pTf0L-xfGByp2r3fNekrQQ_26HJdMPr",
      "posthogKey": "phc_AWm9NYadeyvRG4mASJPC8hcgNV8Ck37S9BAaywNtCZMv",
      "posthogHost": "https://eu.i.posthog.com"
    }
  }
}
